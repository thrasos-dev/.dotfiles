# Ignore everything by default
*

# Allow directories (packages)
!*/

# Repository files
!.gitignore
!README.md

# Repo tooling (not a Stow package)
!scripts/
!scripts/**
!hooks/
!hooks/**

# Wallpapers package
!wallpapers/
!wallpapers/Pictures/
!wallpapers/Pictures/Wallpapers/
!wallpapers/Pictures/Wallpapers/**

# Vim package
!vim/
!vim/.vimrc

# Starship package
!starship/
!starship/.config/
!starship/.config/starship.toml

# Neovim package
!nvim/
!nvim/.config/
!nvim/.config/nvim/
!nvim/.config/nvim/**

# Ghostty package
!ghostty/
!ghostty/.config/
!ghostty/.config/ghostty/
!ghostty/.config/ghostty/**

# VSCode package
!vscode/
!vscode/Library/
!vscode/Library/Application Support/
!vscode/Library/Application Support/Code/
!vscode/Library/Application Support/Code/User/
!vscode/Library/Application Support/Code/User/**

# Cursor package
!cursor/
!cursor/Library/
!vscode/Library/Application Support/
!cursor/Library/Application Support/Cursor/
!cursor/Library/Application Support/Cursor/User/
!cursor/Library/Application Support/Cursor/User/**

# Zed package
!zed/
!zed/.config/
!zed/.config/zed/
!zed/.config/zed/settings.json
!zed/.config/zed/tasks.json
!zed/.config/zed/keymap.json

# Aerospace package
!aerospace/
!aerospace/.config/
!aerospace/.config/aerospace/
!aerospace/.config/aerospace/**

# Helix package
!helix/
!helix/.config/
!helix/.config/helix/
!helix/.config/helix/**

# Claude package
!claude/
!claude/.claude/
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json

# Herdr package
!herdr/
!herdr/.config/
!herdr/.config/herdr/
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/new-claude-tab.sh
!herdr/.config/herdr/plugins/
!herdr/.config/herdr/plugins/tab-title/
!herdr/.config/herdr/plugins/tab-title/herdr-plugin.toml
!herdr/.config/herdr/plugins/tab-title/tab-title.sh

# Ignore .DS_Store files everywhere
**/.DS_Store
.DS_Store
