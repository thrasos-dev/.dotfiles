// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Open Typst Preview",
    "command": "open -na Safari http://127.0.0.1:23635/ && osascript -e 'tell application \"Safari\" to close (every tab of every window whose URL is not \"http://127.0.0.1:23635/\")'",
    "allow_concurrent_runs": false,
    "hide": "always",
    "reveal": "never",
    "reveal_target": "dock",
    "shell": "system",
    "show_command": true,
    "show_summary": true,
    "tags": ["typst"],
    "use_new_terminal": true
  },
  {
    "label": "Run Minecraft Client",
    "command": "./gradlew runClient",
    "allow_concurrent_runs": true,
    "hide": "on_success",
    "reveal": "no_focus",
    "use_new_terminal": true
  }
]
